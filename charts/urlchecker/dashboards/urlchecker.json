    {
      "type": "timeseries",
      "title": "Packet loss",
      "description": "Share of echo requests without a reply, per instance and target. smokeping_prober's formula: 1 − replies / requests.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clamp_min(1 - sum by (instance, host) (rate(urlchecker_icmp_response_duration_seconds_count{job=~\"$job\", instance=~\"$instance\", host=~\"$host\"}[$__rate_interval])) / (sum by (instance, host) (rate(urlchecker_icmp_requests_total{job=~\"$job\", instance=~\"$instance\", host=~\"$host\"}[$__rate_interval])) > 0), 0)",
          "refId": "A",
          "legendFormat": "{{instance}} → {{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
